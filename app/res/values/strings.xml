    <string name="status_ready_title">Android Auto is ready</string>
    <string name="status_ready_body">This unit already has Android Auto, enabled. No icon? Open it from Settings &gt; Connected devices, or tap Open to jump to its App info.</string>
    <string name="status_disabled_title">Android Auto is disabled</string>
    <string name="status_disabled_body">Android Auto is installed on this unit but turned off for user 0. One command turns it back on.</string>
    <string name="status_hidden_title">Android Auto is unreachable</string>
    <string name="status_hidden_body">Android Auto is enabled, but this ROM hides its launcher entry or withholds a permission. Repair re-installs it for user 0 and grants location.</string>
    <string name="status_receiver_title">No Android Auto package</string>
    <string name="status_receiver_body">There is nothing to enable: this ROM never shipped Android Auto. AiPlay can act as the head unit itself — experimental, handshake only in this version.</string>
    <string name="status_no_gms_title">No Android Auto, no Play services</string>
    <string name="status_no_gms_body">This ROM has neither Android Auto nor Google Play services. Only AiPlay\'s own receiver can help, and it is experimental.</string>

