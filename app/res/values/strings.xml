    <!-- Setup -->
    <string name="setup_title">ADB recipe</string>
    <string name="setup_intro">Run these on a laptop with the head unit connected by USB (or over Wi-Fi ADB). Every command is safe and reversible.</string>
    <string name="setup_notes">If step 1 prints nothing, this ROM has no Android Auto to enable — use the wireless receiver instead. If step 4 prints no activity, the package is installed but not exposed; a system install is required.</string>
